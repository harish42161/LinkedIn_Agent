# ============================================================
# Streamlit Community Cloud Secrets Template
# DO NOT commit the real secrets.toml — add via the dashboard
# https://share.streamlit.io → App Settings → Secrets
# ============================================================

[auth]
# Dashboard password (set a strong password!)
DASHBOARD_PASSWORD = "your_strong_password_here"

[linkedin]
LINKEDIN_LI_AT = "your_li_at_cookie_value"
LINKEDIN_JSESSIONID = "your_jsessionid_value"
LINKEDIN_ENCRYPTION_KEY = "your_fernet_encryption_key"

[app]
APPLICATION_MODE = "auto_submit"
MINIMUM_MATCH_SCORE = "95.0"
CANDIDATE_PROFILE_PATH = "linkedin_job_agent/data/candidate_profile.json"
RESUME_PATH = "linkedin_job_agent/resumes/harish_ghadage_resume.txt"
DATABASE_PATH = "linkedin_job_agent/data/jobs.db"

[notifications]
WEBHOOK_URL = ""
NOTIFICATION_EMAIL = ""
